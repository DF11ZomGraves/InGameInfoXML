    "issues": "https://github.com/DF11ZomGraves/InGameInfoXML/issues"
  },
  "license": "MIT",
  "icon": "assets/ingameinfo/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "df11zomgraves.ingameinfo.InGameInfoXMLServer"
    ],
    "client": [
      "df11zomgraves.ingameinfo.InGameInfoXML"
    ]
  },
  "mixins": [
    "ingameinfoxml.mixins.json"
  ],
  "depends": {
